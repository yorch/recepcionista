// Recepcionista data model.
// Field names match src/lib/types.ts exactly — the DB layer maps snake_case
// columns onto the camelCase Prisma fields, so no caller ever learns about either.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Business {
  id                      String   @id @default(uuid())
  name                    String
  url                     String?
  phone                   String?  @unique
  /**
   * Last 10 digits of `phone`, maintained by the db layer. Indexed lookup for inbound calls.
   */
  phoneKey                String?  @map("phone_key")
  /**
   * IANA zone the business operates in. All hours/slot math happens in it.
   */
  timezone                String   @default("America/New_York")
  ownerPhone              String?  @map("owner_phone")
  ownerName               String?  @map("owner_name")
  hours                   Json     @default("{}")
  serviceArea             String[] @map("service_area")
  status                  String   @default("onboarding")
  /**
   * ElevenLabs ConvAI agent id — persisted so a restart reuses the agent.
   */
  agentId                 String?  @map("agent_id")
  /// PII retention window in days (calls, transcripts, SMS bodies, briefings; booking PII is nulled).
  retentionDays           Int      @default(365) @map("retention_days")
  /// Spoken at call start when set; overrides the default recording disclosure.
  recordingDisclosureText String?  @map("recording_disclosure_text")
  createdAt               DateTime @default(now()) @map("created_at")

  /// E.164 form of `phone` / `owner_phone` (nullable: unparseable numbers stay NULL). `phone_key` stays for dual-read.
  phoneE164              String?   @map("phone_e164")
  ownerPhoneE164         String?   @map("owner_phone_e164")
  /// Billing (Stripe). 'none' | 'trialing' | 'active' | 'past_due' | 'canceled' | 'unpaid' (CHECK in the migration).
  billingStatus          String    @default("none") @map("billing_status")
  plan                   String?
  stripeCustomerId       String?   @map("stripe_customer_id")
  stripeSubscriptionId   String?   @map("stripe_subscription_id")
  trialEndsAt            DateTime? @map("trial_ends_at") @db.Timestamptz(6)
  currentPeriodEnd       DateTime? @map("current_period_end") @db.Timestamptz(6)
  cancelAtPeriodEnd      Boolean   @default(false) @map("cancel_at_period_end")
  /// Maintained by setBillingState: when billing_status last became 'past_due' (start of the grace period).
  pastDueSince           DateTime? @map("past_due_since") @db.Timestamptz(6)
  /// Per-business caps; NULL = use env PLAN_SMS_CAP / PLAN_CALL_MINUTES_CAP.
  smsCapOverride         Int?      @map("sms_cap_override")
  callMinutesCapOverride Int?      @map("call_minutes_cap_override")
  /// Set once the owner proved they control `owner_phone` (alert destination).
  ownerPhoneVerifiedAt   DateTime? @map("owner_phone_verified_at") @db.Timestamptz(6)

  /// Call handling mode: 'ai' (default) | 'paused' (AI does not answer: polite message + voicemail) | 'forward' (ring `forward_number`). CHECK in the migration.
  callMode                String    @default("ai") @map("call_mode")
  /// Where 'forward' sends calls (as typed) and its E.164 form. Only ever dialled once `forward_number_verified_at` is set
  /// (or it is the verified owner phone).
  forwardNumber           String?   @map("forward_number")
  forwardNumberE164       String?   @map("forward_number_e164")
  /// SMS-code verification of the forward number (cleared whenever the number changes).
  forwardNumberVerifiedAt DateTime? @map("forward_number_verified_at") @db.Timestamptz(6)
  /// 'forward' only during business hours; outside them the AI answers.
  forwardDuringHours      Boolean   @default(false) @map("forward_during_hours")

  /// Default language of the dashboard/texts for this business: 'en' | 'es' (CHECK in the migration).
  localeDefault    String  @default("en") @map("locale_default")
  /// Trade the default prompt/templates are written for: hvac | plumbing | electrical | cleaning | landscaping | dental | general (CHECK).
  vertical         String  @default("hvac")
  /// Chosen ElevenLabs voice (id and a display name); NULL = the platform default voice.
  voiceId          String? @map("voice_id")
  voiceName        String? @map("voice_name")
  /// Deposit refund policy on cancellation: 'none' | 'full_24h' | 'full_48h' | 'full_always' (CHECK), plus optional free text (<= 2000 chars).
  refundPolicy     String  @default("full_24h") @map("refund_policy")
  refundPolicyText String? @map("refund_policy_text")
  /// Subscription billing cadence: 'month' | 'year' (CHECK).
  billingInterval  String  @default("month") @map("billing_interval")

  knowledgeBase KnowledgeBase?
  calls         Call[]
  bookings      Booking[]
  briefings     Briefing[]
  smsLog        SmsLog[]
  smsOptOuts    SmsOptOut[]
  users         User[]
  usageCounters UsageCounter[]
  emailTokens   EmailToken[]

  memberships         Membership[]
  activeSessions      UserSession[]
  calendarConnections CalendarConnection[]
  calendarBusyBlocks  CalendarBusyBlock[]
  ownerKbChanges      OwnerKbChange[]

  @@index([phoneKey])
  @@index([phoneE164])
  @@index([ownerPhoneE164])
  @@index([agentId])
  @@index([stripeCustomerId])
  @@index([status])
  @@map("businesses")
}

model KnowledgeBase {
  id           String   @id @default(uuid())
  businessId   String   @unique @map("business_id")
  services     Json     @default("[]")
  faqs         Json     @default("[]")
  pricingNotes String   @default("") @map("pricing_notes")
  systemPrompt String   @default("") @map("system_prompt")
  callScript   String   @default("") @map("call_script")
  updatedAt    DateTime @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("knowledge_bases")
}

model Call {
  id                 String    @id @default(uuid())
  businessId         String    @map("business_id")
  /// Telephony call SID (Twilio `system__call_sid`) when the call came in over the phone.
  callSid            String?   @unique @map("call_sid")
  /// ElevenLabs conversation id (`system__conversation_id`). The post-call webhook is correlated by this
  /// (or by the SID), so a call is one row whichever path created it.
  conversationId     String?   @unique @map("conversation_id")
  callerPhone        String?   @map("caller_phone")
  /// E.164 form of caller_phone (NULL when unparseable / withheld).
  callerE164         String?   @map("caller_e164")
  callerName         String?   @map("caller_name")
  startedAt          DateTime  @default(now()) @map("started_at")
  endedAt            DateTime? @map("ended_at")
  durationSec        Int?      @map("duration_sec")
  language           String?
  transcript         String?
  summary            String?
  urgency            String    @default("unsure")
  status             String    @default("in_progress")
  recordingUrl       String?   @map("recording_url")
  flaggedReason      String?   @map("flagged_reason")
  /// True once the recording/AI disclosure was spoken to the caller.
  recordingDisclosed Boolean   @default(false) @map("recording_disclosed")
  /// 'unknown' | 'disclosed' | 'declined' (CHECK constraint in the migration).
  consentStatus      String    @default("unknown") @map("consent_status")
  /// 'customer' (a caller of the business) | 'owner' (the owner phoned in to update the knowledge base). CHECK in the migration.
  kind               String    @default("customer")
  /// Live transfer to a human: 'none' | 'attempted' | 'connected' | 'failed' | 'declined'. CHECK in the migration.
  transferStatus     String    @default("none") @map("transfer_status")
  /// Twilio `StirStatus` (verstat) as received, e.g. 'TN-Validation-Passed-A'. See attestationLevel() in src/lib/stir.ts.
  stirStatus         String?   @map("stir_status")
  /// True when STIR/SHAKEN fully verified the caller number (attestation A). NULL = not evaluated (legacy / no verstat).
  callerVerified     Boolean?  @map("caller_verified")
  /// Set once this call's usage was added to the counters (claimCallMetering). Rows from before the column are backfilled as settled.
  meteredAt          DateTime? @map("metered_at") @db.Timestamptz(6)
  /// How many times the reconcile job tried to fetch this call's final data from the provider.
  reconcileAttempts  Int       @default(0) @map("reconcile_attempts")

  business         Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bookings         Booking[]
  transcriptEvents CallTranscriptEvent[]
  ownerKbChanges   OwnerKbChange[]

  @@index([businessId, startedAt])
  @@index([businessId, callerE164])
  @@index([meteredAt, startedAt])
  @@map("calls")
}

model Booking {
  id                    String    @id @default(uuid())
  callId                String?   @map("call_id")
  businessId            String    @map("business_id")
  customerName          String    @map("customer_name")
  customerPhone         String    @map("customer_phone")
  /// E.164 form of customer_phone (NULL when unparseable or erased).
  phoneE164             String?   @map("phone_e164")
  service               String
  scheduledAt           DateTime  @map("scheduled_at")
  /// Length of the job. Together with scheduled_at it forms the blocked interval;
  /// a Postgres exclusion constraint (see migrations) forbids overlaps per business.
  durationMinutes       Int       @default(60) @map("duration_minutes")
  address               String?
  /// MONEY IS INTEGER CENTS everywhere (price_estimate, deposit_amount).
  priceEstimate         Int?      @map("price_estimate")
  depositAmount         Int?      @map("deposit_amount")
  depositPaid           Boolean   @default(false) @map("deposit_paid")
  status                String    @default("confirmed")
  createdAt             DateTime  @default(now()) @map("created_at")
  /// Set when customer PII was nulled (retention purge or erasure request); financial fields are kept.
  anonymizedAt          DateTime? @map("anonymized_at")
  /// When (and how) the customer was told they may get follow-up texts. Recorded by the server when a
  /// confirmation that carries the notice is delivered to this booking's own number; gates gratitude texts.
  followupConsentAt     DateTime? @map("followup_consent_at")
  followupConsentSource String?   @map("followup_consent_source")

  /// Rebook lineage: the booking this one replaced (self FK, SET NULL). Moving a booking in place (rescheduleBooking) keeps the row.
  rescheduledFromId       String?   @map("rescheduled_from_id")
  /// How many times this booking was moved with rescheduleBooking.
  rescheduleCount         Int       @default(0) @map("reschedule_count")
  cancelledAt             DateTime? @map("cancelled_at") @db.Timestamptz(6)
  cancelReason            String?   @map("cancel_reason")
  /// When the customer was last told about a change (cancel / reschedule). NULL = not notified yet.
  customerNotifiedAt      DateTime? @map("customer_notified_at") @db.Timestamptz(6)
  stripePaymentIntentId   String?   @map("stripe_payment_intent_id")
  stripeCheckoutSessionId String?   @map("stripe_checkout_session_id")
  /// 'none' | 'pending' | 'refunded' | 'failed' | 'not_applicable' (CHECK in the migration).
  refundStatus            String    @default("none") @map("refund_status")
  /// INTEGER CENTS actually refunded.
  refundAmountCents       Int?      @map("refund_amount_cents")
  stripeRefundId          String?   @map("stripe_refund_id")
  refundedAt              DateTime? @map("refunded_at") @db.Timestamptz(6)

  business        Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  call            Call?              @relation(fields: [callId], references: [id], onDelete: SetNull)
  rescheduledFrom Booking?           @relation("BookingReschedule", fields: [rescheduledFromId], references: [id], onDelete: SetNull)
  rescheduledTo   Booking[]          @relation("BookingReschedule")
  smsLog          SmsLog[]
  calendarLink    CalendarEventLink?

  @@index([businessId, scheduledAt])
  @@index([businessId, phoneE164])
  @@index([stripePaymentIntentId])
  @@index([stripeCheckoutSessionId])
  @@index([rescheduledFromId])
  @@map("bookings")
}

model Briefing {
  id         String   @id @default(uuid())
  businessId String   @map("business_id")
  date       String
  audioUrl   String?  @map("audio_url")
  transcript String
  stats      Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, date])
  @@map("briefings")
}

model SmsLog {
  id           String   @id @default(uuid())
  businessId   String   @map("business_id")
  toPhone      String   @map("to_phone")
  /// E.164 form of to_phone (NULL when unparseable).
  toE164       String?  @map("to_e164")
  body         String
  kind         String
  bookingId    String?  @map("booking_id")
  providerId   String?  @map("provider_id")
  status       String   @default("queued")
  /// Why we were allowed to send: 'transactional_booking' | 'caller_initiated' | 'express_opt_in' | 'owner_alert' | ...
  consentBasis String?  @map("consent_basis")
  createdAt    DateTime @default(now()) @map("created_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  booking  Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
  @@index([businessId, toE164])
  @@index([consentBasis, createdAt])
  @@index([bookingId])
  @@map("sms_log")
}

/// SMS suppression list (STOP). Kept through erasure/retention on purpose: forgetting an opt-out would re-enable texting.
model SmsOptOut {
  id         String   @id @default(uuid())
  businessId String   @map("business_id")
  /// Last 10 digits (see phoneKey in src/lib/format.ts).
  phoneKey   String   @map("phone_key")
  /// E.164 form (NULL for legacy rows that could not be normalised; matched by phone_key meanwhile).
  phoneE164  String?  @map("phone_e164")
  optedOutAt DateTime @default(now()) @map("opted_out_at")
  /// 'stop_keyword' | 'manual' | 'complaint' | ...
  source     String

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, phoneKey])
  @@index([businessId, phoneE164])
  @@index([phoneE164])
  @@map("sms_opt_outs")
}

/// Fixed-window counters for the Postgres rate limiter. Rows are disposable.
model RateLimitBucket {
  key         String
  windowStart DateTime @map("window_start") @db.Timestamptz(6)
  count       Int      @default(0)

  @@id([key, windowStart])
  @@index([windowStart])
  @@map("rate_limit_buckets")
}

/// Webhook/event dedupe (claimEvent). Composite key: ids are only unique per source.
/// `status` 'processing' is a lease (a crashed worker's claim can be taken over after `claimed_at` + lease); 'done' is final.
model ProcessedEvent {
  id        String
  source    String
  status    String   @default("done")
  claimedAt DateTime @default(now()) @map("claimed_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([source, id])
  @@index([createdAt])
  @@map("processed_events")
}

/// Expiring lease for long critical sections (provisioning does network IO).
model ProvisionLock {
  key        String   @id
  holder     String
  acquiredAt DateTime @default(now()) @map("acquired_at") @db.Timestamptz(6)
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)

  @@index([expiresAt])
  @@map("provision_locks")
}

model User {
  id           String    @id @default(uuid())
  /// Always stored lowercased (CHECK constraint); lookups lowercase too.
  email        String    @unique
  passwordHash String    @map("password_hash")
  /// LEGACY "primary" business (kept for compatibility; DB triggers mirror it into `memberships`). Null only for role 'admin' (CHECK constraint).
  /// The source of truth for who belongs to which business is `memberships`.
  businessId   String?   @map("business_id")
  /// 'owner' | 'staff' | 'admin' (for owner/staff: the role in the primary business; see `memberships` for the others)
  role         String
  createdAt    DateTime  @default(now()) @map("created_at")
  disabledAt   DateTime? @map("disabled_at")

  /// NULL until the address was proven (verify link, or invite acceptance). Pre-existing users are backfilled.
  emailVerifiedAt  DateTime? @map("email_verified_at") @db.Timestamptz(6)
  /// E.164, nullable (SMS second factor / alerts).
  phone            String?
  /// AES-256-GCM envelope (see src/lib/totp.ts) of the base32 TOTP secret. Set at enrolment, active once totp_enabled_at is set.
  totpSecretEnc    String?   @map("totp_secret_enc")
  totpEnabledAt    DateTime? @map("totp_enabled_at") @db.Timestamptz(6)
  /// Last accepted 30s time step (replay protection): a code is accepted only for a strictly greater step.
  totpLastUsedStep Int?      @map("totp_last_used_step")
  /// UI/text language of this user: 'en' | 'es' (CHECK in the migration).
  locale           String    @default("en")

  business           Business?            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sessions           UserSession[]
  recoveryCodes      RecoveryCode[]
  emailTokens        EmailToken[]         @relation("TokenUser")
  invitedTokens      EmailToken[]         @relation("TokenInviter")
  memberships        Membership[]
  passkeys           PasskeyCredential[]
  webauthnChallenges WebauthnChallenge[]
  connectedCalendars CalendarConnection[]

  @@index([businessId])
  @@map("users")
}

model UserSession {
  id               String    @id @default(uuid())
  /// NULL only for kind 'admin_token' (break-glass ADMIN_TOKEN login); CHECK constraint.
  userId           String?   @map("user_id")
  /// 'user' | 'admin_token'
  kind             String    @default("user")
  /// sha256 hex of the raw token; the raw token is never stored.
  tokenHash        String    @unique @map("token_hash")
  expiresAt        DateTime  @map("expires_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  lastUsedAt       DateTime  @default(now()) @map("last_used_at")
  /// Set when the second factor was satisfied for this session (NULL = password only / no MFA).
  mfaVerifiedAt    DateTime? @map("mfa_verified_at") @db.Timestamptz(6)
  /// Last time the holder proved who they are (set at login, and by POST /api/auth/reauth). Sensitive changes (call forwarding)
  /// need it within the last 5 minutes. NULL on rows from before the column existed = not recent.
  sudoAt           DateTime? @map("sudo_at") @db.Timestamptz(6)
  ip               String?
  userAgent        String?   @map("user_agent")
  /// The business this session is currently working in (multi-business accounts). NULL = the primary / only one.
  /// Set only through setSessionActiveBusiness, which verifies an active membership in the same statement.
  activeBusinessId String?   @map("active_business_id")

  user           User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeBusiness Business? @relation(fields: [activeBusinessId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([activeBusinessId])
  @@index([expiresAt])
  @@map("user_sessions")
}

/// One-time TOTP recovery codes. Only the sha256 of the (normalised) code is stored.
model RecoveryCode {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, codeHash])
  @@map("recovery_codes")
}

/// Single-use emailed tokens: purpose 'verify' | 'reset' | 'invite'. Only the sha256 of the token is stored.
model EmailToken {
  id         String    @id @default(uuid())
  /// Set for verify/reset; NULL for invites (the account does not exist yet).
  userId     String?   @map("user_id")
  email      String
  purpose    String
  tokenHash  String    @unique @map("token_hash")
  /// Invite only: where the invitee will land and with which role.
  businessId String?   @map("business_id")
  role       String?
  invitedBy  String?   @map("invited_by")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt     DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user     User?     @relation("TokenUser", fields: [userId], references: [id], onDelete: Cascade)
  business Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  inviter  User?     @relation("TokenInviter", fields: [invitedBy], references: [id], onDelete: SetNull)

  @@index([email, purpose])
  @@index([userId])
  @@index([businessId])
  @@index([expiresAt])
  @@map("email_tokens")
}

/// Append-only security/audit trail. No FKs on purpose: the trail must outlive the users/businesses it names.
model AuditEvent {
  id          String   @id @default(uuid())
  at          DateTime @default(now()) @db.Timestamptz(6)
  actorUserId String?  @map("actor_user_id")
  /// 'user' | 'admin_token' | 'system' | 'webhook' (CHECK constraint)
  actorKind   String   @map("actor_kind")
  businessId  String?  @map("business_id")
  action      String
  target      String   @default("")
  ip          String?
  /// Small structured context. NEVER secrets, tokens or message bodies.
  meta        Json     @default("{}")

  @@index([businessId, at])
  @@index([actorUserId, at])
  @@index([at])
  @@map("audit_events")
}

/// Monthly (business-timezone calendar month) usage for plan caps. Updated only by atomic upserts (src/lib/db/usage.ts).
model UsageCounter {
  id                 String    @id @default(uuid())
  businessId         String    @map("business_id")
  /// First day of the month in the business's timezone.
  periodStart        DateTime  @map("period_start") @db.Date
  smsCount           Int       @default(0) @map("sms_count")
  /// AI conversation seconds ONLY (the plan's call-minutes cap gates on this alone).
  callSeconds        Int       @default(0) @map("call_seconds")
  /// Voicemail recording seconds (own cap, VOICEMAIL_MINUTES_CAP): never counted against the AI minutes.
  voicemailSeconds   Int       @default(0) @map("voicemail_seconds")
  /// Bridged seconds of forwarded calls (own cap, FORWARD_MINUTES_CAP): never counted against the AI minutes.
  forwardSeconds     Int       @default(0) @map("forward_seconds")
  /// "80% / 100% of the cap used" warnings already sent this period, per kind (markWarned claims each exactly once).
  smsWarned80At      DateTime? @map("sms_warned_80_at") @db.Timestamptz(6)
  smsWarned100At     DateTime? @map("sms_warned_100_at") @db.Timestamptz(6)
  aiWarned80At       DateTime? @map("ai_warned_80_at") @db.Timestamptz(6)
  aiWarned100At      DateTime? @map("ai_warned_100_at") @db.Timestamptz(6)
  forwardWarned80At  DateTime? @map("forward_warned_80_at") @db.Timestamptz(6)
  forwardWarned100At DateTime? @map("forward_warned_100_at") @db.Timestamptz(6)
  updatedAt          DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, periodStart])
  @@map("usage_counters")
}

/// A forwarded call in progress: caps SIMULTANEOUS forwards per business and reserves the minutes they may still use (review 6, M1).
/// Deleted when the call is metered; an unreleased row expires by itself (`expires_at`). No foreign key: expired rows are swept by acquire.
model ForwardLease {
  businessId      String   @map("business_id")
  callSid         String   @map("call_sid")
  reservedSeconds Int      @map("reserved_seconds")
  expiresAt       DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([businessId, callSid])
  @@index([expiresAt])
  @@map("forward_leases")
}

/// Provider-side (Twilio) voicemail recordings that MUST be deleted. Written in the same transaction that deletes the call row
/// (retention purge, customer erasure, demo reset), so the only reference to a recording is never dropped before a durable record
/// of the deletion exists. The jobs runner drains it with retries and backoff; a row goes away only on 2xx or 404 from the provider.
/// No foreign key to businesses on purpose: it must outlive a cascade delete of the tenant.
model PendingRecordingDeletion {
  id            String    @id @default(uuid())
  accountSid    String    @map("account_sid")
  recordingSid  String    @map("recording_sid")
  /// For reporting only (erasure / export say how many are pending for THIS business); not a foreign key.
  businessId    String?   @map("business_id")
  attempts      Int       @default(0)
  lastError     String?   @map("last_error")
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  /// Set once the "deletion is not draining" alert fired for this row.
  alertedAt     DateTime? @map("alerted_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([accountSid, recordingSid])
  @@index([nextAttemptAt])
  @@index([businessId])
  @@map("pending_recording_deletions")
}

/// Free-trial abuse guard: one trial per payment card / normalised email. `fingerprint` is a hash (card: Stripe's
/// card fingerprint, email: HMAC of the normalised address), never the raw value.
model TrialFingerprint {
  id          String   @id @default(uuid())
  /// 'card' | 'email'
  kind        String
  fingerprint String
  businessId  String?  @map("business_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([kind, fingerprint])
  @@map("trial_fingerprints")
}

/// One row per (business, provider): the Google Calendar a business connected. Tokens exist ONLY as AES-GCM envelopes
/// (src/lib/totp.ts encryptSecret, aad = this row's id). Public helpers never return them except getDecryptedTokens.
model CalendarConnection {
  id                String    @id @default(uuid())
  businessId        String    @map("business_id")
  connectedByUserId String?   @map("connected_by_user_id")
  /// 'google'
  provider          String    @default("google")
  accountEmail      String    @map("account_email")
  calendarId        String    @default("primary") @map("calendar_id")
  accessTokenEnc    String?   @map("access_token_enc")
  refreshTokenEnc   String?   @map("refresh_token_enc")
  tokenExpiresAt    DateTime? @map("token_expires_at") @db.Timestamptz(6)
  scopes            String    @default("")
  /// Google incremental-sync token (events.list nextSyncToken).
  syncToken         String?   @map("sync_token")
  watchChannelId    String?   @map("watch_channel_id")
  watchResourceId   String?   @map("watch_resource_id")
  watchExpiresAt    DateTime? @map("watch_expires_at") @db.Timestamptz(6)
  /// 'active' | 'needs_reauth' | 'revoked' | 'error' (CHECK in the migration)
  status            String    @default("active")
  lastSyncAt        DateTime? @map("last_sync_at") @db.Timestamptz(6)
  lastError         String?   @map("last_error")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  business    Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  connectedBy User?               @relation(fields: [connectedByUserId], references: [id], onDelete: SetNull)
  links       CalendarEventLink[]
  busyBlocks  CalendarBusyBlock[]

  @@unique([businessId, provider])
  @@index([status])
  @@index([watchExpiresAt])
  @@index([watchChannelId])
  @@map("calendar_connections")
}

/// A booking pushed to Google as an event (two-way sync bookkeeping).
model CalendarEventLink {
  id             String   @id @default(uuid())
  bookingId      String   @unique @map("booking_id")
  connectionId   String   @map("connection_id")
  googleEventId  String   @map("google_event_id")
  etag           String?
  lastSyncedAt   DateTime @default(now()) @map("last_synced_at") @db.Timestamptz(6)
  /// Hash of the booking fields last pushed, so an unchanged booking is not pushed again.
  lastPushedHash String?  @map("last_pushed_hash")

  booking    Booking            @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  connection CalendarConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, googleEventId])
  @@map("calendar_event_links")
}

/// Busy time mirrored from the business's Google Calendar. Times ONLY: titles, descriptions and attendees are never stored.
model CalendarBusyBlock {
  id              String   @id @default(uuid())
  connectionId    String   @map("connection_id")
  businessId      String   @map("business_id")
  googleEventId   String   @map("google_event_id")
  startsAt        DateTime @map("starts_at") @db.Timestamptz(6)
  endsAt          DateTime @map("ends_at") @db.Timestamptz(6)
  allDay          Boolean  @default(false) @map("all_day")
  /// Google `transparency`: 'opaque' (blocks time) | 'transparent' (shown as free).
  transparency    String   @default("opaque")
  /// Always true: the summary was dropped before storing (kept as a column so a reader can see the redaction was applied).
  summaryRedacted Boolean  @default(true) @map("summary_redacted")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  connection CalendarConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  business   Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([connectionId, googleEventId])
  @@index([businessId, startsAt, endsAt])
  @@map("calendar_busy_blocks")
}

/// A knowledge-base edit proposed by the owner (phone call, SMS or dashboard). `patch` holds the new values of the touched KB
/// fields; `previous` the values they replaced (captured when applied) so the change can be reverted.
model OwnerKbChange {
  id         String    @id @default(uuid())
  businessId String    @map("business_id")
  callId     String?   @map("call_id")
  /// 'owner_voice' | 'owner_sms' | 'dashboard' (CHECK)
  source     String
  /// 'proposed' | 'applied' | 'reverted' | 'rejected' (CHECK)
  status     String    @default("proposed")
  summary    String
  patch      Json      @default("{}")
  previous   Json?
  appliedAt  DateTime? @map("applied_at") @db.Timestamptz(6)
  revertedAt DateTime? @map("reverted_at") @db.Timestamptz(6)
  createdBy  String?   @map("created_by")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  call     Call?    @relation(fields: [callId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
  @@index([callId])
  @@map("owner_kb_changes")
}

/// Live transcript of a call, one row per utterance. Deleted with the call (cascade); never stored for calls whose consent is 'declined'.
model CallTranscriptEvent {
  id      String   @id @default(uuid())
  callId  String   @map("call_id")
  seq     Int
  /// 'agent' | 'caller' | 'system' (CHECK)
  role    String
  text    String
  at      DateTime @db.Timestamptz(6)
  /// False while the utterance is still being transcribed (an interim row is replaced by the final one with the same seq).
  isFinal Boolean  @default(true) @map("is_final")

  call Call @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@unique([callId, seq])
  @@map("call_transcript_events")
}

/// A WebAuthn credential (passkey) of a user.
model PasskeyCredential {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  /// base64url credential id, as sent by the browser.
  credentialId String    @unique @map("credential_id")
  /// COSE public key bytes.
  publicKey    Bytes     @map("public_key")
  counter      BigInt    @default(0)
  transports   String[]
  /// 'singleDevice' | 'multiDevice'
  deviceType   String    @default("singleDevice") @map("device_type")
  backedUp     Boolean   @default(false) @map("backed_up")
  name         String    @default("Passkey")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt   DateTime? @map("last_used_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("passkey_credentials")
}

/// Single-use WebAuthn challenge. Only the sha256 of the challenge is stored; consume is one atomic UPDATE.
model WebauthnChallenge {
  id            String    @id @default(uuid())
  /// Set for 'register' and 'reauth'; NULL for a discoverable-credential 'login' (the user is learned from the assertion).
  userId        String?   @map("user_id")
  /// 'register' | 'login' | 'reauth' (CHECK)
  purpose       String
  challengeHash String    @unique @map("challenge_hash")
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt        DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([userId])
  @@map("webauthn_challenges")
}

/// Who belongs to which business, with which role. Source of truth for access; users.business_id/role stay as the legacy primary
/// (DB triggers mirror legacy writes into this table). Roles here are only 'owner' | 'staff' (admins have no memberships).
model Membership {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  businessId String    @map("business_id")
  role       String
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  disabledAt DateTime? @map("disabled_at") @db.Timestamptz(6)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
  @@index([businessId])
  @@map("memberships")
}
