# One file, two uses:
#   - `docker compose -f compose.production.yaml` reads it for interpolation
#     AND passes it into the app container (env_file).
#   - native `bun dev` reads .env.local; Prisma's CLI reads .env.
#
# Copy to .env and fill in. Anything marked REQUIRED makes `compose up` refuse to
# start when blank — that is deliberate, so a misconfigured deploy fails loudly
# at boot instead of silently running with mock integrations.

# ── Public origin ───────────────────────────────────────────────────────────
# REQUIRED. DOMAIN is what Traefik requests a certificate for; APP_URL is what
# Twilio, ElevenLabs and Stripe call back to, and what Stripe's return links
# point at. deploy.sh aborts if they disagree.
DOMAIN=recepcionista.example.com
APP_URL=https://recepcionista.example.com

# Router/service name inside Traefik. Must be unique per host: two apps sharing
# this name overwrite each other's routes.
TRAEFIK_NAME=recepcionista

# ── Postgres (the bundled `db` service) ─────────────────────────────────────
# REQUIRED. The password must not contain @ : / # unless percent-encoded,
# because it is interpolated into a connection URL.
POSTGRES_USER=recepcionista
POSTGRES_PASSWORD=
POSTGRES_DB=recepcionista

# Point the app at a managed database instead of the bundled one. When set, the
# `db` service is unused (it still starts unless you remove it).
# DATABASE_URL_OVERRIDE=postgresql://user:pass@host:5432/db?schema=public

# Image tags. Default to local build tags; set these to a registry path if you
# switch away from building on the host.
# APP_IMAGE=recepcionista-app:local
# TOOLS_IMAGE=recepcionista-tools:local

# ── LLM ─────────────────────────────────────────────────────────────────────
# Leave unset and extraction/briefing fall back to templates instead of failing.
# For a demo that is the difference between "works" and "works but sounds canned".
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=gpt-6-luna
ANTHROPIC_MODEL=

# ── ElevenLabs (voice agent + briefing TTS) ─────────────────────────────────
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_VOICE_ID=PStJ2DzQnh8zxG5PDf1s
ELEVENLABS_PHONE_NUMBER_ID=

# ── Twilio (inbound calls + outbound SMS) ───────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── Stripe (emergency deposits) ─────────────────────────────────────────────
STRIPE_SECRET_KEY=
# Strongly recommended in production: without it the webhook accepts unsigned
# payloads, meaning anyone who finds the URL can mark a deposit as paid.
STRIPE_WEBHOOK_SECRET=

# ── Optional ────────────────────────────────────────────────────────────────
# REVIEW_URL=https://g.page/r/your-business/review
# PRISMA_LOG=1
