# Copy to `.env` and fill in. Used by:
#   - native dev (`bun dev`, `bunx prisma ...`): Prisma and Next read `.env`
#     (not `.env.local`). Copy this file to `.env`, then add keys as needed.
#   - `docker compose -f compose.production.yaml`: interpolates it and passes it
#     into the app container (env_file). Variables marked REQUIRED make
#     `compose up` or `deploy.sh` refuse to start when blank. That is deliberate.
# Never commit `.env`. Secrets below are left blank on purpose.
# Every variable (required?, default, feature, secret?) is tabulated in docs/env-vars.md.

# ── Database ────────────────────────────────────────────────────────────────
# REQUIRED for native dev. Matches compose.dev.yaml (Postgres on localhost:5433).
# The dev database is named recepcionista_dev (db:seed refuses names without dev/test/scratch/local).
# Existing local volume? See "Renaming the dev database" in README.md.
# Production compose builds its own DATABASE_URL from the POSTGRES_* values
# below and ignores this line.
DATABASE_URL=postgresql://recepcionista:recepcionista@localhost:5433/recepcionista_dev?schema=public

# ── Public origin ───────────────────────────────────────────────────────────
# REQUIRED for production. DOMAIN is what Traefik requests a certificate for;
# APP_URL is what Twilio, ElevenLabs and Stripe call back to, and what Stripe's
# return links point at. deploy.sh aborts unless APP_URL is https://DOMAIN.
DOMAIN=recepcionista.example.com
APP_URL=https://recepcionista.example.com

# Optional. Public origin used to build absolute links. Defaults to APP_URL.
# PUBLIC_BASE_URL=https://recepcionista.example.com

# Router/service name inside Traefik. Must be unique per host: two apps sharing
# this name overwrite each other's routes.
TRAEFIK_NAME=recepcionista

# ── Authentication ──────────────────────────────────────────────────────────
# REQUIRED for production. Shared secret for the owner dashboard (sign in at
# /login) and for `Authorization: Bearer <token>` on the API. Generate with:
#   openssl rand -hex 32
ADMIN_TOKEN=
# Local development ONLY. With ADMIN_TOKEN / TWILIO_AUTH_TOKEN / ELEVENLABS_*_SECRET
# unset, the app FAILS CLOSED (401/503) in every mode. Set this to true to skip admin
# auth and webhook/tool secret checks on your own machine. Ignored when
# NODE_ENV=production. Never set it on a host reachable from the internet
# (tunnels included): `next dev` + a tunnel + this flag is an open instance.
# ALLOW_INSECURE_DEV=true
# Set true ONLY when a reverse proxy you control (Traefik) overwrites X-Forwarded-For.
# Otherwise the login rate limit ignores client-supplied forwarding headers.
# TRUSTED_PROXY=true
# How many proxies append to X-Forwarded-For in front of the app (default 1: Traefik). Behind a CDN
# (Cloudflare) AND Traefik set 2, so rate limits key on the client rather than on the CDN's address.
# TRUSTED_PROXY_HOPS=1

# ── Compliance ──────────────────────────────────────────────────────────────
# Automatic PII retention purge. OFF unless exactly "on": existing businesses default to a 365-day window,
# so switching it on deletes (and anonymises) everything older than that. Review Dashboard > Settings per
# business first; preview with POST /api/admin/retention {"dry_run":true}. Boot logs what would be purged.
# RETENTION_JOB=on
# Background jobs (docs/runbook.md "Background jobs"): the 6 PM daily briefing (per business time zone), the hourly gratitude
# sweep, and the hourly cleanup of expired sessions / email tokens / events / rate-limit rows. They run inside the app process under
# Postgres leases, so several app instances are safe. JOBS=on|off: default ON in production, OFF in development and test.
# "off" also stops the retention purge. Inspect/run by hand: GET /api/admin/jobs, POST /api/admin/jobs/run (dry run by default).
# JOBS=on   (also true/false, 1/0, yes/no; deploy.sh accepts the same set the app does)
# Owner texts a CALLER can trigger (flag_emergency, handoff_to_human) per business per hour: a budget separate from the plan SMS cap
# (default 6; the first emergency of a call may exceed it up to 2x). Alert text is cut to 320 GSM-safe characters.
# OWNER_ALERT_HOURLY_LIMIT=6
# Owner call-in (docs/owner-call-in.md): the verified owner phones the business line to update the AI's knowledge; changes apply only after an SMS reply.
# OWNER_CALLIN_ENABLED=true
# OWNER_CALL_MAX_SECONDS=300
# Seconds between scheduler passes (5-3600, default 60).
# JOBS_TICK_SECONDS=60
# Text the model-relayed booking phone when a call has NO verified caller id. Default off: bookings are
# stored with that number but only the caller id the platform reports is ever texted.
# ALLOW_UNVERIFIED_BOOKING_SMS=true

# ── Security headers (docs/security-headers.md) ─────────────────────────────
# Pages get a strict nonce-based Content-Security-Policy minted per request in src/proxy.ts. Set true while rolling it out on
# a new deployment: the nonce-less moderate policy is then enforced and only violations of the strict one are reported.
# CSP_REPORT_ONLY=true
# Optional collector URL added to the policy as `report-uri` (you operate it; the app ships none).
# CSP_REPORT_URI=
# upgrade-insecure-requests: default (unset) = only in production with an https APP_URL. Set false for a plain-HTTP staging box,
# true to force it. See docs/security-headers.md.
# CSP_UPGRADE_INSECURE=

# ── Demo ────────────────────────────────────────────────────────────────────
# Optional, dev and demo only. Enables demo-only routes such as /api/demo/reset, the demo console and the mock checkout.
# Ignored when NODE_ENV=production. Leave unset on any public host.
# DEMO_MODE=true
# `bun scripts/seed.ts` creates the demo business with a VERIFIED owner phone and billing_status 'active', so a demo
# install works with BILLING_ENFORCED=true and without OWNER_PHONE_GRANDFATHER. deploy.sh refuses DEMO_MODE=true.

# ── Postgres (the bundled `db` service) ─────────────────────────────────────
# REQUIRED for production. The password must not contain @ : / # unless
# percent-encoded, because it is interpolated into a connection URL.
POSTGRES_USER=recepcionista
POSTGRES_PASSWORD=
POSTGRES_DB=recepcionista

# Optional. Point the app at a managed database instead of the bundled one.
# When set, the `db` service is unused (it still starts unless you remove it).
# DATABASE_URL_OVERRIDE=postgresql://user:pass@host:5432/db?schema=public

# Optional. Image tags. Default to local build tags; set these to a registry
# path if you switch away from building on the host.
# APP_IMAGE=recepcionista-app:local
# TOOLS_IMAGE=recepcionista-tools:local

# ── LLM ─────────────────────────────────────────────────────────────────────
# Leave unset and extraction/briefing fall back to templates instead of failing.
# Optional, but without any LLM key website-to-knowledge-base extraction is REFUSED (422) and call summaries / briefing narration
# fall back to templates. OpenAI is used when OPENAI_API_KEY is set, otherwise Anthropic.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional. Defaults in code: LLM_MODEL=gpt-4o-mini, ANTHROPIC_MODEL=claude-sonnet-4-5.
# LLM_MODEL=gpt-4o-mini
# ANTHROPIC_MODEL=claude-sonnet-4-5

# ── ElevenLabs (voice agent + briefing TTS) ─────────────────────────────────
# Required for production (no key = no voice agent: nothing speaks a disclosure). In development, unset means a mock agent,
# DEMO_MODE scripted calls and no live TTS audio.
ELEVENLABS_API_KEY=
# Bootstrap for a SINGLE-business install only. An agent is never shared between
# businesses: with more than one business each gets its own agent.
ELEVENLABS_AGENT_ID=
# Optional. Voice used for briefing TTS and the agent prompt.
ELEVENLABS_VOICE_ID=PStJ2DzQnh8zxG5PDf1s
# Voices an owner may pick in Settings: comma separated voice ids, each optionally `id:Display Name`. Unset = ElevenLabs' own premade voices
# (GET /v1/voices, category premade). A voice outside this set is refused (422). Without ELEVENLABS_API_KEY the picker is disabled.
# ELEVENLABS_VOICE_ALLOWLIST=
# Optional. The phnum_... id used to bind the inbound number to the agent.
ELEVENLABS_PHONE_NUMBER_ID=
# REQUIRED for production. Verifies the HMAC signature on ElevenLabs webhook
# calls (post-call). Provisioning creates the webhook and returns its signing secret
# ONCE in the admin-only provision response (`webhook_secret`): copy it here and
# redeploy. deploy.sh requires it whenever ELEVENLABS_API_KEY is set.
ELEVENLABS_WEBHOOK_SECRET=
# REQUIRED for production. Shared secret placed in the request headers of every agent
# tool (x-recepcionista-tool-secret) when provisioning; /api/voice/tools/* rejects calls
# without it (fails closed in production). Generate with: openssl rand -hex 32
# After setting or rotating it, re-provision the agent so the tools pick it up.
ELEVENLABS_TOOL_SECRET=
# Optional. Id of an ElevenLabs workspace secret holding the SAME value as ELEVENLABS_TOOL_SECRET: the tool headers then
# reference it instead of embedding the value.
# ELEVENLABS_TOOL_SECRET_ID=

# ── Twilio (inbound calls + outbound SMS) ───────────────────────────────────
# Required for production. In development, without these SMS is only logged to the console/dashboard (a mock). In PRODUCTION an
# incomplete Twilio config makes every text fail (sms_provider_not_configured), never a fake success. Number purchases set the SMS
# URL (APP_URL/api/sms/inbound); fix older numbers with POST /api/admin/repair-numbers.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Optional. Default US/Canada area code for newly bought tenant numbers (3 digits, default 305). A business is bought a
# number in the area code of its own owner phone when that is valid; this applies to the rest.
# TWILIO_AREA_CODE=305
# ── Call handling: pause / forward (docs/runbook.md section 8) ──────────────
# Which kind of phone line this deployment answers on. Forwarding to a human only exists on a "webhook" line (the number's
# Twilio Voice URL is /api/voice/incoming); on the documented production setup (number imported into ElevenLabs = "native")
# the dashboard says "Forwarding is not available on the AI voice line" and refuses the Forward choice. Unset: native when
# ELEVENLABS_API_KEY and ELEVENLABS_PHONE_NUMBER_ID are both set, webhook otherwise.
# VOICE_LINE_KIND=native
# Optional. Calling codes a forward number may belong to (default: SMS_ALLOWED_COUNTRY_CODES). Premium, toll-free, Caribbean
# and territory numbers are always refused, and re-checked on every forwarded call.
# FORWARD_ALLOWED_COUNTRY_CODES=1
# Optional. Extra NANP area codes to refuse as forward targets (3 digits, comma separated), on top of the built-in list
# (premium 900/976, toll-free, Caribbean, 670/671/684 territories).
# FORWARD_DENY_AREA_CODES=
# Optional. Longest single forwarded call in seconds (default 3600) and forwarded calls / voicemails one business may take per hour
# from ALL callers together (default 60 each). The forwarded minutes still left cap every forwarded call as well.
# FORWARD_MAX_CALL_SECONDS=3600
# FORWARD_CALLS_PER_HOUR=60
# VOICEMAIL_PER_HOUR=60
# Round 6 (H1): every CALLER has a budget of their own per business and hour (default 3 forwards, 2 voicemails); callers that
# withhold their number share ONE stricter bucket (default 5 and 3). A caller over theirs gets the voicemail / "try again later"
# without touching the business budget. Callers who are not known customers (no booking or answered AI call in 90 days) may use at most
# CALLER_UNKNOWN_SHARE_PCT percent (default 75) of the business budget; the rest is reserved for known customers.
# FORWARD_PER_CALLER_PER_HOUR=3
# VOICEMAIL_PER_CALLER_PER_HOUR=2
# FORWARD_WITHHELD_PER_HOUR=5
# VOICEMAIL_WITHHELD_PER_HOUR=3
# CALLER_UNKNOWN_SHARE_PCT=75
# Round 6 (M1): forwarded and voicemail minutes have their OWN monthly caps and never use the AI call minutes (defaults 600 / 30 while
# trialing / 60). At most FORWARD_MAX_CONCURRENT forwarded calls per business at once (default 3; one slot is kept for known customers).
# A forwarded leg that ends in under FORWARD_MIN_ANSWERED_SECONDS (default 6; 0 = off) or is flagged as a machine counts as unanswered.
# The owner's phone rings FORWARD_RING_SECONDS (10-40, default 20: shorter than most carriers' voicemail pickup).
# FORWARD_MINUTES_CAP=600
# TRIAL_FORWARD_MINUTES_CAP=30
# VOICEMAIL_MINUTES_CAP=60
# FORWARD_MAX_CONCURRENT=3
# FORWARD_MIN_ANSWERED_SECONDS=6
# FORWARD_RING_SECONDS=20

# --- Phase 2 telephony (docs/runbook.md sections 6 and 8) -------------------------------------------------------------------
# Live transfer on the NATIVE ElevenLabs line (transfer-to-number system tool, destination per call). DEFAULT off: provider behaviour must be
# live-tested first (runbook section 8, "Live transfer test"). on|off. When on, Forward works on the native line and the dashboard says so.
# NATIVE_TRANSFER=off
# STIR/SHAKEN: per-caller identity and the known-customer reserved share apply only to attestation-A callers (Twilio StirVerstat). Set off ONLY
# for a deployment whose callers are mostly outside the US/Canada (no verstat there): it restores caller-id identity. on (default) | off.
# STIR_TRUST=on
# Language detection system tool (English/Spanish switching) on provisioning. on (default) | off.
# LANGUAGE_DETECTION=on
# Live transcript: concurrent SSE streams per user (3) and per business (20) per app instance; upstream polls per call (600, about 20 min).
# LIVE_MAX_PER_USER=3
# LIVE_MAX_PER_BUSINESS=20
# LIVE_MAX_POLLS_PER_CALL=600
# Metering reconciliation: calls older than this many minutes (default 20) with no post-call minutes are fetched from ElevenLabs; gives up after N tries (5).
# RECONCILE_AFTER_MINUTES=20
# RECONCILE_MAX_ATTEMPTS=5
# Optional, default off. true: a paused call on the AI line also overrides the agent PROMPT (needs the prompt override enabled on
# the agent; re-provision first). The tools are refused while paused either way.
# ELEVENLABS_PAUSED_PROMPT_OVERRIDE=false

# Optional. Comma-separated country calling codes SMS may be sent to. Enforced on
# EVERY outbound text (also confirmations, payment links and owner alerts), so an
# owner outside these countries will not receive alerts until their code is added.
SMS_ALLOWED_COUNTRY_CODES=1

# ── Stripe (emergency deposits) ─────────────────────────────────────────────
# Optional. Without STRIPE_SECRET_KEY, deposit links use the local /pay/[id] mock (development only; payment links fail in production).
# Use a test-mode key (sk_test_...) unless you have completed a live review.
STRIPE_SECRET_KEY=
# REQUIRED for production. Verifies Stripe webhook signatures (whsec_...).
# Without it, the webhook rejects unsigned payloads.
STRIPE_WEBHOOK_SECRET=
# Dev only. Set to 1 to accept unsigned Stripe webhooks when no secret is set.
# Never set this on a public host: anyone who finds the URL could mark a deposit
# as paid.
# STRIPE_ALLOW_UNSIGNED=true  # also requires ALLOW_INSECURE_DEV=true

# ── Dev only ────────────────────────────────────────────────────────────────
# Optional. Comma-separated extra origins allowed to load dev assets (for
# example a tunnel hostname). Read by next.config.ts. Dev only.
# ALLOWED_DEV_ORIGINS=tunnel.example.com

# Optional, `bun scripts/create-user.ts`: password for non-interactive use (it refuses --password on the command line).
# CREATE_USER_PASSWORD=

# ── Optional ────────────────────────────────────────────────────────────────
# Optional. Google review link sent in gratitude texts.
# REVIEW_URL=https://g.page/r/your-business/review
# Optional. Log every Prisma query (1 = on).
# PRISMA_LOG=1

# ── Logging ─────────────────────────────────────────────────────────────────
# Optional. debug | info | warn | error. Defaults to debug outside production,
# info inside. One structured line per event; keys/tokens are redacted by name.
# LOG_LEVEL=info

# ── Email (verification, password reset, team invites) ──────────────────────
# resend | smtp | log. REQUIRED in production (resend or smtp): unset fails closed and the
# endpoints that send mail answer 503. `log` (the non-production default) only writes the
# message, including its link, to the application log and is refused in production.
# deploy.sh refuses to deploy without resend/smtp, EMAIL_FROM and the matching key.
# EMAIL_PROVIDER=resend
# From address, e.g. "Recepcionista <no-reply@yourdomain.com>". Required for resend and smtp.
# EMAIL_FROM=
# resend: API key from resend.com.
# RESEND_API_KEY=
# smtp: either one URL (smtps://user:pass@host:465) ...
# SMTP_URL=
# ... or the parts. SMTP_SECURE=true for implicit TLS (port 465), false for STARTTLS (587).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false
# Public origin used to build links in emails (PUBLIC_BASE_URL wins over APP_URL). Required in production.
# PUBLIC_BASE_URL=https://app.example.com

# ── Secrets at rest ─────────────────────────────────────────────────────────
# REQUIRED in production (deploy.sh checks): 32 random bytes, base64. Encrypts TOTP secrets (AES-256-GCM).
# Generate with: openssl rand -base64 32
# Losing or changing it makes every enrolled authenticator unusable (users fall back to recovery codes).
# Outside production an insecure fixed key is used, with a warning.
# APP_SECRET_KEY=

# ── Accounts: self-signup, 2FA, break-glass sessions ────────────────────────
# Open self-signup (/signup) is always on; these are its abuse controls. Per-IP and per-address limits are
# built in (Postgres). Per-IP limits only work behind TRUSTED_PROXY=true (see above).
# Platform-wide cap on accounts CREATED per hour. Default 60. Only created accounts count (existing-address and honeypot
# requests do not), one client may use at most 20% of it (50% for the shared key without a trusted proxy), signup degrades
# at 70% (one account per client; Turnstile is mandatory when configured) and stops for everybody only at 100% (logged loudly).
# SIGNUP_MAX_PER_HOUR=60
# A stale (>24 h) UNVERIFIED signup no longer holds its email address: a new signup for it replaces it (verified accounts never).
# Cloudflare Turnstile on the signup form. Both unset = off. With the SECRET set the server verifies the token
# (5 s timeout) and FAILS CLOSED; the SITE key is public (inlined at build time, so set it before `next build`).
# TURNSTILE_SECRET_KEY=
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# PRODUCTION: open signup REQUIRES the pair above. Without it (and without the next line) POST /api/auth/signup answers
# 503 signup_disabled, /signup shows an invite-only notice and deploy.sh refuses to deploy. Invites keep working.
# Explicit, NOT recommended opt-out (logs a loud startup warning; deploy.sh prints a banner):
# SIGNUP_ALLOW_WITHOUT_CAPTCHA=false
# Price text shown on the onboarding plan step, e.g. "$149/month after a 7-day free trial" (build time; public).
# NEXT_PUBLIC_PLAN_PRICE_DISPLAY=
# Same for the optional annual plan, e.g. "$1,490/year (2 months free)" (build time; public). Shown only when STRIPE_PRICE_ID_ANNUAL is set.
# NEXT_PUBLIC_PLAN_PRICE_DISPLAY_ANNUAL=
# "true": admin users (DB role admin) must enrol in two-step verification before using the dashboard or API
# (they are sent to /dashboard/security). Default off. Needs APP_SECRET_KEY in production.
# REQUIRE_2FA_FOR_ADMINS=false

# Passkeys (WebAuthn). The relying party is the host of PUBLIC_BASE_URL (else APP_URL): nothing to set for a normal deployment.
# Origins must be https (http only for localhost). WEBAUTHN_RP_ID widens the rpID to a parent domain (credentials then work on its
# subdomains too; changing it later orphans existing passkeys). WEBAUTHN_ORIGINS adds exact extra origins, comma separated (staging).
# WEBAUTHN_RP_ID=
# WEBAUTHN_ORIGINS=
# The most businesses one account may own ("Add another location"). Default 10, max 100.
# MAX_BUSINESSES_PER_USER=10

# ── Billing and plan limits ─────────────────────────────────────────────────
# FAIL CLOSED in production: plans are ENFORCED (provisioning, texts and calls refused for businesses whose billing_status is
# not trialing/active, or past_due within the grace period) unless BILLING_ENFORCED=false is set explicitly. deploy.sh and
# compose.production.yaml refuse to run with it unset or invalid, and print a loud banner for "false". Even with "false",
# a non-admin tenant can never provision a number/agent without a plan in production. Outside production (dev/test) nothing is
# refused unless it is "true".
# REQUIRED in .env on a production host (uncomment). Left commented here so a local dev copy of this file is not enforced.
# BILLING_ENFORCED=true
# Days a past_due business keeps working after its payment first failed. Default 5.
# BILLING_PAST_DUE_GRACE_DAYS=5
# Default monthly caps (per calendar month in the business time zone); per-business overrides
# (businesses.sms_cap_override / call_minutes_cap_override) win. Defaults 500 texts / 300 minutes.
# PLAN_SMS_CAP=500
# PLAN_CALL_MINUTES_CAP=300
# Texts are counted in SMS SEGMENTS (GSM-7: 160, then 153 per segment; any emoji/accented non-GSM character switches the whole text
# to UCS-2: 70, then 67), not in sends; a text that would not fit in what is left of the cap is not sent.
# Lower caps while billing_status='trialing' (a trial never gets more than the paid plan cap; admin per-business overrides win).
# Only enforced while BILLING_ENFORCED is on. Defaults 50 texts (segments) / 30 minutes.
# TRIAL_SMS_CAP=50
# TRIAL_CALL_MINUTES_CAP=30
# Stripe subscription (docs/billing.md). STRIPE_SECRET_KEY (above) is also used. REQUIRED when BILLING_ENFORCED=true
# (deploy.sh checks): the recurring monthly price id (price_...) and the signing secret of the BILLING webhook endpoint
# (/api/billing/webhook, a different secret from STRIPE_WEBHOOK_SECRET).
# STRIPE_PRICE_ID=
# OPTIONAL second price (price_...): the annual plan. Offered at checkout (interval 'year') only when set. In the Stripe Customer Portal
# allow "customers can switch plans" with both prices so owners can switch (docs/billing.md).
# STRIPE_PRICE_ID_ANNUAL=
# STRIPE_BILLING_WEBHOOK_SECRET=
# Free-trial length for a new subscription, 0-90 days. Default 7.
# BILLING_TRIAL_DAYS=7
# Plan label stored on subscribed businesses. Default "standard".
# BILLING_PLAN_NAME=standard
# Show the promotion-code box in Checkout.
# BILLING_ALLOW_PROMO_CODES=true
# Without STRIPE_SECRET_KEY (development only, never production) checkout is a local mock that needs DEMO_MODE=true.

# ── Phone numbers ───────────────────────────────────────────────────────────
# Optional. ISO country assumed for numbers typed without a "+" (E.164 normalisation). Default US.
# DEFAULT_PHONE_COUNTRY=US

# ── Owner phone verification and ElevenLabs initiation webhook ─────────────
# Owner alerts (emergency / handoff / payment / low-rating escalations) go ONLY to an owner phone verified by an SMS
# code (Settings > Your alert phone, or onboarding step 3; POST /api/businesses/:id/owner-phone/verify/{start,confirm}). Verified numbers are
# exempt from SMS_ALLOWED_COUNTRY_CODES. Rollout switch, default off and DANGEROUS (an unverified number then bypasses
# opt-outs and the country allow-list): "true" treats existing owner_phones as verified until their owners re-verify. In
# production it is IGNORED unless OWNER_PHONE_GRANDFATHER_ACK=i-understand is also set (startup logs a warning either way).
# Limit it: _BEFORE = only businesses created before that instant (the deploy time), _UNTIL = it expires at that instant.
# Turn it OFF once owners verified. The grandfather script never verifies a phone (docs/billing.md).
# OWNER_PHONE_GRANDFATHER=false
# OWNER_PHONE_GRANDFATHER_ACK=
# OWNER_PHONE_GRANDFATHER_BEFORE=2026-11-25T00:00:00Z
# OWNER_PHONE_GRANDFATHER_UNTIL=2026-12-15T00:00:00Z
# Owner-phone verification texts are abuse-limited per user, IP, number and platform-wide (docs/runbook.md section 6).
# OWNER_VERIFY_GLOBAL_PER_HOUR=300
# OWNER_VERIFY_GLOBAL_PER_DAY=2000
# "off" stops provisioning from configuring the ElevenLabs conversation-initiation webhook (/api/voice/initiation)
# via the API; set it up by hand then (docs/runbook.md). It is authenticated with ELEVENLABS_TOOL_SECRET.
# ELEVENLABS_INITIATION_WEBHOOK=auto

# --- Google Calendar two-way sync (docs/integrations/google-calendar.md) ---------------------------------------------------
# OAuth client of type "Web application". Leave GOOGLE_CLIENT_ID empty to turn the feature off. Required together (deploy.sh checks).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Default: ${APP_URL}/api/integrations/google/callback (must match the console EXACTLY). APP_URL must be https in production.
# GOOGLE_OAUTH_REDIRECT_URI=
# HMAC key for push-channel tokens (optional: derived from APP_SECRET_KEY when unset). openssl rand -base64 32
# GOOGLE_WEBHOOK_SECRET=
# Fake Google for local development / e2e ONLY. IGNORED in production (boot logs an error; deploy.sh refuses it).
# GOOGLE_OAUTH_MOCK=true
# Debugging only: true stops masking phone numbers and emails in logs (credentials are always masked).
# LOG_PII=true
