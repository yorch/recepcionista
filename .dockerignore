# ── Dependencies ────────────────────────────────────────────────
node_modules
**/node_modules

# ── Build output ────────────────────────────────────────────────
# Copied from the builder stage, never from the context.
.next
**/.next
tsconfig.tsbuildinfo
next-env.d.ts

# ── Env files ───────────────────────────────────────────────────
# `.env.*` does not match `.env` itself, hence both lines; the negation comes
# last so it wins. Without this, live provider keys from a developer's
# .env.local would be baked into an image layer.
.env
.env.*
# Same rules at any depth, so a nested .env.local cannot leak either.
**/.env
**/.env.*
!.env.example

# ── VCS / editor / OS ───────────────────────────────────────────
.git
.gitignore
.vscode
.idea
.DS_Store

# ── Local infra state and backups ───────────────────────────────
data/
.postgres-data/
# deploy.sh writes gzipped pg_dumps here: contain every customer row.
backups/
**/backups/
# Root-level only: prisma/migrations/*.sql is needed by the tools target.
/*.sql
*.sql.gz
*.dump

# ── Keys and certificates ───────────────────────────────────────
**/*.pem
**/*.key
**/*.p12

# ── Runtime-generated media and agent tooling ───────────────────
# Briefing audio is produced at runtime into the audio volume, never baked in.
public/audio/
.claude/
.github/
*.log

# ── Docs and screenshots (not needed to build or run) ───────────
*.md
!README.md
